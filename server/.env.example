# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed website origins (CORS)
CLIENT_ORIGINS=http://localhost:5173

# --- Email (Titan / Nodemailer SMTP) ---
# Use a mailbox with 2-Step Verification OFF.
# SMTP_PASS is the mailbox password, not an app password.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@infincode.org
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=info@infincode.org
CONTACT_SENDER_EMAIL=info@infincode.org
# Set to false to disable the automatic "we received your inquiry" email to visitors
SEND_ACKNOWLEDGMENT=true

# --- AI chatbot (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
