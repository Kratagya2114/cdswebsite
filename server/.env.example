# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed website origins (CORS)
CLIENT_ORIGINS=http://localhost:5173

# --- Email (Nodemailer / SMTP) ---
# Gmail: enable 2-Step Verification, then create an "App password"
# (Google Account > Security > App passwords) and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=keshavdeepakvyas@gmail.com
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=keshavdeepakvyas@gmail.com
CONTACT_SENDER_EMAIL=keshavdeepakvyas@gmail.com
# Set to false to disable the automatic "we received your inquiry" email to visitors
SEND_ACKNOWLEDGMENT=true

# --- AI chatbot (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
